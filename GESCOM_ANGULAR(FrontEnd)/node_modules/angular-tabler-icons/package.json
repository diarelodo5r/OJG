{
  "name": "angular-tabler-icons",
  "version": "3.26.0",
  "description": "Tabler Icons components library for your Angular applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierreavn/angular-tabler-icons.git"
  },
  "keywords": [
    "angular",
    "tabler",
    "icons",
    "svg",
    "2",
    "ui",
    "components",
    "library"
  ],
  "author": "Pierre Avinain",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pierreavn/angular-tabler-icons/issues"
  },
  "homepage": "https://github.com/pierreavn/angular-tabler-icons",
  "peerDependencies": {
    "@angular/common": "17 - 19",
    "@angular/core": "17 - 19"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "module": "fesm2022/angular-tabler-icons.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./fesm2022/angular-tabler-icons.mjs"
    },
    "./icons": {
      "types": "./icons/index.d.ts",
      "default": "./fesm2022/angular-tabler-icons-icons.mjs"
    }
  },
  "sideEffects": false
}